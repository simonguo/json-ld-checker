{
  "manifest_version": 3,
  "name": "JSON-LD Checker",
  "version": "2.3.2",
  "description": "Inspect, validate, and improve JSON-LD structured data from a developer-focused browser side panel.",
  "homepage_url": "https://github.com/simonguo/json-ld-checker",
  "minimum_chrome_version": "114",
  "permissions": [
    "activeTab",
    "sidePanel",
    "scripting",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/png/icon-inactive-16.png",
      "32": "icons/png/icon-inactive-32.png",
      "48": "icons/png/icon-inactive-48.png",
      "128": "icons/png/icon-inactive-128.png"
    },
    "default_title": "JSON-LD Checker"
  },
  "side_panel": {
    "default_path": "src/pages/sidepanel/index.html"
  },
  "options_page": "src/pages/options/index.html",
  "icons": {
    "16": "icons/png/icon-16.png",
    "32": "icons/png/icon-32.png",
    "48": "icons/png/icon-48.png",
    "128": "icons/png/icon-128.png"
  }
}
